<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
		title="{i18n>formularioselecionar}"
		items="{formularioModel>/}"
		search="_handleAssociarFormularioValueHelpSearch"
		confirm="_handleAssociarFormularioValueHelpClose"
		cancel="_handleAssociarFormularioValueHelpClose">
		<StandardListItem
			title="{formularioModel>key}"
			iconDensityAware="false"
			iconInset="false"
			/>
	</SelectDialog>
</core:FragmentDefinition>